# Store text files with LF in the repository, check out with the platform's native endings.
# Without this, the Linux CI runner and a Windows dev machine disagree on every line of
# every file, producing phantom diffs and noisy `core.autocrlf` warnings.
* text=auto

# These are read by Linux tooling at runtime — a CRLF here is a hard failure, not cosmetic.
# A shell script with CRLF fails as "bad interpreter: /bin/sh^M"; Docker and Actions
# parse YAML strictly.
*.sh            text eol=lf
*.yml           text eol=lf
*.yaml          text eol=lf
Dockerfile      text eol=lf
*.dockerfile    text eol=lf
.env.example    text eol=lf

# Windows tooling writes CRLF into these and will keep re-dirtying them otherwise.
*.sln           text eol=crlf
*.bat           text eol=crlf
*.cmd           text eol=crlf

# Never line-ending-convert or attempt to diff these.
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.ico   binary
*.webp  binary
*.pdf   binary
*.woff  binary
*.woff2 binary
*.ttf   binary
*.otf   binary
*.dll   binary
*.pdb   binary
*.snk   binary
