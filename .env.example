# Copy this file to .env and fill in real values before `docker compose up`.
# .env is gitignored — never commit real secrets.

# Database
POSTGRES_DB=assignment_system
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_password_here
DATABASE_URL=Host=db;Database=assignment_system;Username=postgres;Password=your_password_here

# JWT
# JWT_KEY must be at least 32 characters — HS256 signing rejects shorter keys at runtime.
JWT_KEY=your-256-bit-secret-key-here-minimum-32-characters
JWT_ISSUER=AssignmentSystemApi
JWT_AUDIENCE=AssignmentSystemClient

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:5000/api/v1
