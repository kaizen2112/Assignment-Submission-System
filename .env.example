# Copy to .env to override anything below. .env is gitignored — never commit real secrets.
#
# You do not need a .env file to start: docker-compose.yml carries these same values as inline
# defaults, so `docker compose up --build` works on a fresh clone with no setup. This file exists to
# document every variable in one place and to be the place you change them.

# --- Database ---------------------------------------------------------------------------------
POSTGRES_DB=assignment_system
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# Host=db, not localhost: `db` is the service name, which Compose resolves on its internal network.
# Inside the api container, localhost means the api container itself.
# The password here must match POSTGRES_PASSWORD above.
DATABASE_URL=Host=db;Port=5432;Database=assignment_system;Username=postgres;Password=postgres

# --- JWT --------------------------------------------------------------------------------------
# Must be at least 32 bytes — Program.cs refuses to start otherwise, because HS256 signing requires
# a 256-bit key. Replace this for any deployment that is not a local demo.
JWT_KEY=local-docker-only-signing-key-do-not-use-in-production-0123456789
JWT_ISSUER=AssignmentSystemApi
JWT_AUDIENCE=AssignmentSystemClient

# --- Ports (host side) ------------------------------------------------------------------------
# Change these if something already occupies 3000 or 5000 on your machine.
WEB_PORT=3000
API_PORT=5000

# --- Cross-origin wiring ----------------------------------------------------------------------
# These three must agree, or the browser blocks every API call:
#   FRONTEND_ORIGIN    what the API adds to its CORS allow-list
#   NEXT_PUBLIC_API_URL where the browser sends requests
# Both are host-side URLs, because the *browser* makes these calls — not the web container. If you
# change WEB_PORT or API_PORT above, change the matching port here too.
FRONTEND_ORIGIN=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:5000/api/v1
