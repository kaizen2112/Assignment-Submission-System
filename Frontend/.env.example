# Base URL of the ASP.NET Core API, including the /api/v1 prefix.
#
# 5274 is the http port Kestrel binds locally (see Backend/src/Api/Properties/launchSettings.json).
# docs/07 says 5000, which was a guess made before the backend existed — the real port is 5274.
# Plain http on purpose: the https endpoint (7222) uses a self-signed development certificate, and
# the browser blocks fetch() to it until you accept that certificate manually.
NEXT_PUBLIC_API_URL=http://localhost:5274/api/v1
